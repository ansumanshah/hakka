{
  "name": "hakka-cli",
  "version": "0.0.1",
  "description": "Hakka CLI — `npx hakka-cli init` detects your framework (Next.js, Vite, Expo, React Native) and wires up the Hakka network inspector; `hakka diagnose`/`hakka assert` analyze a saved .hakka session or .har capture; `hakka mcp` starts an MCP stdio server exposing live traffic to AI agents; `hakka cdp` streams Chrome DevTools Protocol captures to a bridge hub.",
  "keywords": [
    "ai",
    "cdp",
    "chrome-devtools-protocol",
    "cli",
    "devtools",
    "hakka",
    "init",
    "inspector",
    "mcp",
    "model-context-protocol",
    "network"
  ],
  "homepage": "https://hakka.noodleapps.com",
  "bugs": {
    "url": "https://github.com/ansumanshah/hakka/issues"
  },
  "license": "MIT",
  "author": "Ansuman Shah",
  "repository": {
    "type": "git",
    "url": "https://github.com/ansumanshah/hakka.git",
    "directory": "packages/hakka-cli"
  },
  "bin": {
    "hakka": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__tests__",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./mcp": {
      "source": "./src/mcp/index.ts",
      "types": "./dist/mcp/index.d.mts",
      "default": "./dist/mcp/index.mjs"
    },
    "./cdp": {
      "source": "./src/cdp/index.ts",
      "types": "./dist/cdp/index.d.mts",
      "default": "./dist/cdp/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "bun test src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hakka-bridge": "0.0.1",
    "hakka-core": "0.0.1",
    "hakka-node": "0.0.1",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
