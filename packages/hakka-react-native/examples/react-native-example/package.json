{
  "name": "react-native-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "preandroid": "node scripts/ensure-webview-asset.js",
    "android": "react-native run-android",
    "preios": "node scripts/ensure-webview-asset.js",
    "ios": "react-native run-ios",
    "prestart": "node scripts/ensure-webview-asset.js",
    "start": "react-native start",
    "start:rozenite": "WITH_ROZENITE=true ROZENITE_DEV_MODE=hakka-rozenite react-native start",
    "test": "jest",
    "pretypecheck": "node scripts/ensure-webview-asset.js",
    "typecheck": "tsc --noEmit",
    "copy:hakka-browser": "node scripts/copy-hakka-browser.js",
    "bundle": "node scripts/ensure-webview-asset.js && react-native bundle --entry-file index.js --platform ios --dev true --bundle-output /tmp/hakka-rn-ci-bundle.js --assets-dest /tmp/hakka-rn-ci-assets"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "1.16.3",
    "hakka-react-native": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "3.0.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.8.0",
    "react-native-svg": "15.15.5",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.12.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/codegen": "0.86.3",
    "@react-native/gradle-plugin": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@rozenite/metro": "2.4.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "19.1.0",
    "hakka-rozenite": "workspace:*",
    "jest": "29.7.0",
    "react-test-renderer": "19.2.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
