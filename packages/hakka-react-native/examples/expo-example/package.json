{
  "name": "expo-example",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "bundle": "expo export:embed --entry-file index.ts --platform ios --dev true --bundle-output /tmp/hakka-expo-ci-bundle.js --assets-dest /tmp/hakka-expo-ci-assets"
  },
  "dependencies": {
    "expo": "57.0.18",
    "hakka-react-native": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/react": "19.2.17",
    "babel-preset-expo": "57.0.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
