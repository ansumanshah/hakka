---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page Not Found | Hakka</title>
    <meta
      name="description"
      content="The requested Hakka docs page could not be found."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      :root {
        color-scheme: light dark;
        --accent: #ee8320;
        --bg: #121110;
        --fg: #ede8e2;
        --muted: #a8a296;
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        background: var(--bg);
        color: var(--fg);
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
      }

      main {
        width: min(42rem, calc(100vw - 2rem));
      }

      h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(2.5rem, 8vw, 5rem);
        line-height: 1;
      }

      p {
        max-width: 32rem;
        margin: 0 0 1.5rem;
        color: var(--muted);
        font-size: 1.125rem;
        line-height: 1.6;
      }

      a {
        color: var(--bg);
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        padding: 0 1rem;
        border-radius: 6px;
        background: var(--accent);
        font-weight: 700;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Page not found</h1>
      <p>That Hakka docs page does not exist yet. Head back to the docs index to keep moving.</p>
      <a href="/">Back to docs</a>
    </main>
  </body>
</html>
