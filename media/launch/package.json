{
  "name": "hakka-launch-video",
  "version": "0.0.0",
  "private": true,
  "description": "Editable local launch animation for Hakka.",
  "license": "MIT",
  "scripts": {
    "preview": "hyperframes preview . --foreground",
    "lint": "hyperframes lint .",
    "check": "hyperframes check . --at 0,1,5,10,15,17,20,24,27,29.9 --snapshots",
    "render": "hyperframes render . --output renders/hakka-launch.mp4"
  },
  "devDependencies": {
    "gsap": "3.15.0",
    "hyperframes": "0.8.60"
  }
}
