{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Standalone examples load these entrypoints through HTML, scripts or subprocesses.
  "workspaces": {
    ".": {
      "entry": [
        "scripts/dep-declaration-check.mjs",
        "scripts/feed-desktop-demo.mjs",
        "examples/browser-demo/assets/tick.js",
        "examples/build-your-own-devtools/{vite.config.ts,src/panel.ts,src/react-main.tsx}",
        "examples/vite-app/{vite.config.ts,src/main.ts}",
        "examples/webpack-probe/{webpack.config.js,rspack.config.js,src/index.js,scripts/*.mjs}",
        "examples/cdp-playwright/{playwright.config.ts,fixtures/demo-server.ts,tests/*.spec.ts}",
        "examples/framework-servers/*.mjs",
        "examples/desktop-bridge/run.mjs",
        "examples/api-automation/run.mjs",
        "examples/otel-spans/*.mjs",
        "examples/prod-cohort/demo.mjs",
        "examples/react-native-benchmark/{App.tsx,scripts/*.mjs}",
      ],
    },
    "packages/hakka-core": {
      // Metro selects this implementation for native platforms.
      "entry": ["src/engine/jsCapture.native.ts"],
    },
    "packages/hakka-browser": {
      "entry": ["src/index.ts", "src/ui/elements/index.ts", "src/plugin/__tests__/fixtures/webpackEntry.js"],
    },
    "packages/hakka-rozenite": {
      // Rozenite maps react-native imports to this renderer in its web build.
      "ignoreDependencies": ["react-native-web"],
    },
    "examples/expo-example": {
      // Expo's Metro pipeline loads Babel via its preset.
      "ignoreDependencies": ["@babel/core"],
    },
  },
  // Convention-loaded files remain analyzed but are not unused-file candidates.
  "ignoreFiles": [
    "packages/hakka-react-native/react-native.config.js",
    "packages/hakka-react-native/src/monitors/index.ts",
    "packages/hakka-react-native/src/utils/index.ts",
    // CLI tools invoked by the justfile (knip can't see justfile recipes).
    "scripts/benchmark-artifact-metadata.mjs",
    "scripts/benchmark-verify.mjs",
    "scripts/benchmark-verify-fixture-test.mjs",
    "scripts/device-readiness.mjs",
    "scripts/ios-runtime-summary.mjs",
    "scripts/rn-mode-benchmark.mjs",
    // Benchmark runners spawn these scripts by string path.
    "packages/hakka-bench/capture-overhead.mjs",
    "packages/hakka-node/bench/capture-overhead.mjs",
    // Docs bundles refreshed by `just sync-embed` / `just sync-embed-components`.
    "docs/public/embed/**",
    "docs/public/embed-components/**",
    // Standalone Next.js consumer outside the workspace graph and plugin discovery.
    "examples/next-fullstack/**",
    // Standalone Remotion project is rendered by its own CLI outside the workspace graph.
    "media/launch/remotion/**",
    // Worker loaded by string path.
    "examples/browser-demo/traced-worker.js",
    // Manual docs-screenshot script, run ad hoc, never imported.
    "packages/hakka-browser/scripts/capture-next-runtime.mjs",
    // Loaded by the Rozenite host convention.
    "packages/hakka-rozenite/react-native.ts",
    "packages/hakka-rozenite/src/react-native/useHakkaRozeniteDevTools.ts",
    // Driven by justfile recipes (knip can't see justfile recipes).
    "scripts/bench-heap.mjs",
    "scripts/spec-api-check-fixture-test.mjs",
    // Chained from verify-smoke.sh, not imported directly.
    "scripts/smoke-bridge-replay.mjs",
    "scripts/smoke-mcp-handshake.mjs",
    "scripts/smoke-trace-correlation.mjs",
  ],
  // Script, native/codegen, and optional peer dependencies.
  "ignoreDependencies": [
    // Loaded by the string-path capture-overhead benchmark.
    "eruda",
    "vconsole",
    "happy-dom",
    "@babel/preset-env",
    "@babel/runtime",
    "@react-native-async-storage/async-storage",
    "@react-native/codegen",
    "@react-native/gradle-plugin",
    "expo",
    "jest-environment-node",
    "react-native-builder-bob",
    "react-native-mmkv",
    // tsdown loads this optional peer while evaluating its config on Node 22.
    "unrun",
    // CSS @import in docs/src/styles/starlight.css, not a JS import.
    "@fontsource-variable/jetbrains-mono",
    "@fontsource-variable/manrope",
    "@fontsource-variable/space-grotesk",
    // hakka-rozenite's peer-mirror devDep (mirrors its own peerDependencies entry).
    "hakka-react-native",
    // Solid runtime pin required by the @solidjs/web patch and RC dedupe (ADR 0007).
    "@solidjs/signals",
  ],
  "ignoreIssues": {
    // Preserve the benchmark's exported contract while analyzing its entrypoints.
    "examples/react-native-benchmark/src/BenchmarkRuntime.ts": ["types"],
    // Public plugins support both default and named imports.
    "packages/hakka-browser/src/plugin/vite.ts": ["duplicates"],
    "packages/hakka-browser/src/plugin/webpack.ts": ["duplicates"],
    "packages/hakka-browser/src/plugin/rspack.ts": ["duplicates"],
    "packages/hakka-react-native/src/native/NativeHakkaMonitor.ts": ["exports", "types"],
    // Public browser embedding interfaces, including barrel exports.
    "packages/hakka-browser/src/ui/viewModels/index.ts": ["types"],
    "packages/hakka-browser/src/ui/viewModels/FilterViewModel.ts": ["types"],
    "packages/hakka-browser/src/ui/viewModels/RequestListViewModel.ts": ["types"],
    "packages/hakka-browser/src/ui/viewModels/RequestDetailViewModel.ts": ["types"],
    "packages/hakka-browser/src/ui/viewModels/SelectionViewModel.ts": ["types"],
    "packages/hakka-browser/src/ui/viewModels/StatsViewModel.ts": ["types"],
    // Public CaptureSource/conformance shapes used structurally (ADR 0006).
    "packages/hakka-core/src/contract/captureSource.ts": ["types"],
    "packages/hakka-core/src/contract/conformance.ts": ["types"],
  },
}
