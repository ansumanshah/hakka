{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Standalone examples are outside Bun's workspace graph. Their HTML, package
  // scripts, and subprocess paths load these entrypoints; trace their imports.
  "workspaces": {
    ".": { "entry": ["scripts/dep-declaration-check.mjs", "scripts/feed-desktop-demo.mjs"] },
    "packages/hakka-browser": {
      "entry": [
        "src/index.ts",
        "src/ui/elements/index.ts",
        "demo/assets/tick.js",
        "examples/build-your-own-devtools/vite.config.ts",
        "examples/build-your-own-devtools/src/{panel.ts,react-main.tsx}",
        "examples/vite-app/{vite.config.ts,src/main.ts}",
        "examples/webpack-probe/{webpack.config.js,src/index.js}",
        "src/plugin/__tests__/fixtures/webpackEntry.js",
      ],
    },
    "packages/hakka-cli": {
      "entry": ["examples/cdp-playwright/{playwright.config.ts,fixtures/demo-server.ts,tests/*.spec.ts}"],
    },
    "packages/hakka-node": {
      "entry": ["examples/framework-servers/*.mjs", "examples/otel-spans/*.mjs", "examples/prod-cohort/demo.mjs"],
    },
    "packages/hakka-rozenite": {
      // Rozenite maps react-native imports to this renderer in its web build.
      "ignoreDependencies": ["react-native-web"],
    },
    "packages/hakka-react-native/examples/expo-example": {
      // Expo's Metro pipeline loads Babel via its preset.
      "ignoreDependencies": ["@babel/core"],
    },
  },
  // Public source entrypoints and React Native autolinking/codegen files.
  // Knip should still analyze them, but they are not removable "unused files".
  "ignoreFiles": [
    "packages/hakka-react-native/react-native.config.js",
    "packages/hakka-react-native/src/monitors/index.ts",
    "packages/hakka-react-native/src/utils/index.ts",
    // CLI tools invoked by the justfile (knip can't see justfile recipes).
    "scripts/benchmark-artifact-metadata.mjs",
    "scripts/benchmark-verify.mjs",
    "scripts/benchmark-verify-fixture-test.mjs",
    "scripts/device-readiness.mjs",
    "scripts/ios-runtime-summary.mjs",
    "scripts/rn-mode-benchmark.mjs",
    // Benchmark runners spawn these scripts by string path.
    "packages/hakka-bench/capture-overhead.mjs",
    "packages/hakka-node/bench/capture-overhead.mjs",
    // Vendored, minified overlay bundles for the docs hero/demo + component embeds
    // (refreshed via `just sync-embed` / `just sync-embed-components`, never imported).
    "docs/public/embed/**",
    "docs/public/embed-components/**",
    // Standalone consumer app, deliberately outside the workspace graph (it resolves
    // hakka packages like a real npm consumer). Next's app-router files are framework
    // entry points knip has no plugin wiring for here.
    "examples/next-fullstack/**",
    // Worker string-path — instantiated via `new Worker('./traced-worker.js')`, knip
    // can't trace a bare string specifier to its target file.
    "packages/hakka-browser/demo/traced-worker.js",
    // Manual docs-screenshot script, run ad hoc, never imported.
    "packages/hakka-browser/scripts/capture-next-runtime.mjs",
    // Rozenite convention-loaded: read directly by the Rozenite CLI/host, not imported.
    "packages/hakka-rozenite/react-native.ts",
    "packages/hakka-rozenite/rozenite.config.ts",
    "packages/hakka-rozenite/src/react-native/useHakkaRozeniteDevTools.ts",
    // Driven by justfile recipes (knip can't see justfile recipes).
    "scripts/bench-heap.mjs",
    "scripts/smoke-tarball-install.mjs",
    // Chained from verify-smoke.sh, not imported directly.
    "scripts/smoke-bridge-replay.mjs",
    "scripts/smoke-mcp-handshake.mjs",
    "scripts/smoke-trace-correlation.mjs",
  ],
  // Dependencies below are consumed by package scripts, RN native build files,
  // codegen/autolinking, Jest config, or optional feature imports that must stay
  // optional peer dependencies.
  "ignoreDependencies": [
    // Loaded only by the capture-overhead benchmark (capture-overhead.mjs is
    // ignoreFiles'd — spawned by string path — so its imports aren't traced).
    "eruda",
    "vconsole",
    "happy-dom",
    "@babel/preset-env",
    "@babel/runtime",
    "@react-native-async-storage/async-storage",
    "@react-native/codegen",
    "@react-native/gradle-plugin",
    "expo",
    "jest-environment-node",
    "react-native-builder-bob",
    "react-native-mmkv",
    // tsdown loads this optional peer while evaluating its config on Node 22.
    "unrun",
    // Optional peers referenced only behind runtime guards (try/catch dynamic require,
    // or an optional-native-module check) — same "referenced optional peer, not a real
    // devDependency" pattern as the RN entries above.
    // CSS @import in docs/src/styles/starlight.css, not a JS import.
    "@fontsource-variable/jetbrains-mono",
    "@fontsource-variable/manrope",
    "@fontsource-variable/space-grotesk",
    // hakka-rozenite's peer-mirror devDep (mirrors its own peerDependencies entry).
    "hakka-react-native",
    // Solid 2.0 RC pins: solid-js's own runtime deps, pinned exactly in
    // hakka-browser so the carried @solidjs/web patch and the RC dedupe stay
    // stable (ADR 0007) — not imported first-party.
    "@solidjs/signals",
  ],
  "ignoreIssues": {
    // Bundler-plugin entries deliberately export the plugin BOTH as default and
    // named `hakka`, so `import hakka from` and `import { hakka } from` both work.
    "packages/hakka-browser/src/plugin/vite.ts": ["duplicates"],
    "packages/hakka-browser/src/plugin/webpack.ts": ["duplicates"],
    "packages/hakka-browser/src/plugin/rspack.ts": ["duplicates"],
    "packages/hakka-react-native/src/native/NativeHakkaMonitor.ts": ["exports", "types"],
    // Generated token mirror — full export set is intentional (not all consumed by RN yet).
    // Mandated design-system kit awaiting screen migration.
    // MV-pattern viewmodel barrel: each VM's State/Intents interfaces are the package's
    // public embedding contract (mirrors hakka-browser's viewmodel pattern) — consumers
    // destructure these shapes even though nothing in-repo imports them yet.
    // Barrel tracked separately from declarations — see FilterViewModel.ts/SelectionViewModel.ts.
    // Browser is the original of the MV contract RN mirrors — same public-embedding-contract
    // reasoning as the RN viewmodel suppressions above.
    "packages/hakka-browser/src/ui/viewModels/index.ts": ["types"],
    "packages/hakka-browser/src/ui/viewModels/FilterViewModel.ts": ["types"],
    "packages/hakka-browser/src/ui/viewModels/RequestListViewModel.ts": ["types"],
    "packages/hakka-browser/src/ui/viewModels/RequestDetailViewModel.ts": ["types"],
    "packages/hakka-browser/src/ui/viewModels/SelectionViewModel.ts": ["types"],
    "packages/hakka-browser/src/ui/viewModels/StatsViewModel.ts": ["types"],
    // ADR 0006's CaptureSource contract, now frozen with eight implementations. A few
    // exported members (CaptureSourceIdentity, CaptureCorrelation, ConformanceCheck) are
    // still only referenced structurally within these files rather than imported by name —
    // they are the published shape third parties implement against, not dead code.
    "packages/hakka-core/src/contract/captureSource.ts": ["types"],
    "packages/hakka-core/src/contract/conformance.ts": ["types"],
  },
}
